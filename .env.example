# GuffSuff Development Environment Configuration Example
# Copy to .env for local development. DO NOT COMMIT .env TO GIT.

NODE_ENV=development
APP_ENV=local

PORT=3000
REALTIME_PORT=3001
ADMIN_PORT=3002

DATABASE_URL=postgresql://guffsuff_user:guffsuff_local_pass@localhost:5432/guffsuff_dev
REDIS_URL=redis://:guffsuff_redis_local_pass@localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=guffsuff-media-local
S3_ACCESS_KEY=guffsuff_minio_local_key
S3_SECRET_KEY=guffsuff_minio_local_secret

JWT_ACCESS_SECRET=dev_only_jwt_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=dev_only_jwt_refresh_secret_do_not_use_in_prod

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
