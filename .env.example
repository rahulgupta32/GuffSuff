# GuffSuff Application Environment Template
# NEVER place real secrets or production credentials in this file.

# Environment Identification
NODE_ENV=development
APP_ENV=local
PORT=3000
REALTIME_PORT=3001

# Default Country Code
DEFAULT_COUNTRY_CODE=+977
TIMEZONE=Asia/Kathmandu

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guffsuff_dev
DB_USER=guffsuff_user
DB_PASSWORD=guffsuff_local_dev_password
DB_MAX_CONNECTIONS=20

# Cache & PubSub (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=guffsuff_redis_local_password

# Object Storage (S3-compatible local emulator e.g. MinIO / LocalStack)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_ATTACHMENTS=guffsuff-encrypted-attachments-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# OTP Configuration
# OTP_TEST_MODE must be FALSE in non-local environments.
OTP_TEST_MODE=true
OTP_TEST_CODE=123456
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# JWT & Session Security
JWT_ACCESS_SECRET=local_dev_jwt_access_secret_do_not_use_in_prod_min_32_chars
JWT_REFRESH_SECRET=local_dev_jwt_refresh_secret_do_not_use_in_prod_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Cryptography / Non-production Crypto Mock Flag
# CRYPTO_MOCK_MODE is strictly for early UI/integration development and MUST be false in production.
CRYPTO_MOCK_MODE=true

# Logging & Observability
LOG_LEVEL=debug
LOG_FORMAT=json
OPENTELEMETRY_COLLECTOR_URL=http://localhost:4318

# Admin & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
